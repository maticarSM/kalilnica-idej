# Email (Resend - https://resend.com)
# 1. Registriraj se na resend.com (brezplačno)
# 2. Ustvari API ključ: resend.com/api-keys
# 3. Ustvari Audience: resend.com/audiences → kopiraj ID
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Od koga se pošiljajo emaili
# Brez verificirane domene uporabi: Kalilnica idej <onboarding@resend.dev>
FROM_EMAIL=Kalilnica idej <onboarding@resend.dev>

# URL spletne strani (brez trailing slash)
SITE_URL=https://kalilnica-idej.vercel.app
